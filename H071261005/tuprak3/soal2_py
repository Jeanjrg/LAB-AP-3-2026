print("Setup Denah Bioskop NontonYuk\n")

# Validasi input Jumlah Baris (N)
while True:
    try:
        baris_input = input("Masukkan jumlah baris: ")
        n_baris = int(baris_input)
        if n_baris <= 0:
            print("Jumlah baris harus lebih dari 0!")
            continue
        break
    except ValueError:
        print("Input baris harus berupa angka!")

# Validasi input Jumlah Kursi per Baris (M)
while True:
    try:
        kursi_input = input("Masukkan jumlah kursi per baris: ")
        m_kursi = int(kursi_input)
        if m_kursi <= 0:
            print("Jumlah kursi harus lebih dari 0!")
            continue
        break
    except ValueError:
        print("Input kursi harus berupa angka!")

print("\nDaftar Kursi Tersedia")

# Nested loop untuk mencetak denah kursi
for baris in range(1, n_baris + 1):
    for kursi in range(1, m_kursi + 1):
        # Aturan Mitos: Kursi nomor 13 dilewati
        if kursi == 13:
            continue

        # Aturan Baris VVIP (Baris 1): Hanya kursi ganjil
        if baris == 1:
            if kursi % 2 != 0:
                print(f"Baris {baris} Kursi {kursi}")
        # Aturan Baris Reguler (Baris 2 dan seterusnya)
        else:
            print(f"Baris {baris} Kursi {kursi}")